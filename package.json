{
  "name": "unofficialyoutube",
  "version": "1.0.0",
  "description": "Unofficial YouTube InnerTube API wrapper for Cloudflare Workers",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
